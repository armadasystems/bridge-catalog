{
  "type": "object",
  "title": "OAI 5G Basic Configuration",
  "properties": {
    "global": {
      "type": "object",
      "title": "Global Settings",
      "properties": {
        "kubernetesDistribution": {
          "type": "string",
          "title": "Kubernetes Distribution",
          "enum": ["Vanilla", "Openshift"],
          "default": "Vanilla"
        },
        "coreNetworkConfigMap": {
          "type": "string",
          "title": "Core Network ConfigMap Name",
          "default": "oai-5g-basic"
        },
        "clusterIpServiceIpAllocation": {
          "type": "boolean",
          "title": "Allocate IP to ClusterIP Service",
          "default": true
        },
        "waitForNRF": {
          "type": "boolean",
          "title": "Wait for NRF Ready",
          "default": true
        },
        "waitForUDR": {
          "type": "boolean",
          "title": "Wait for UDR Ready",
          "default": true
        },
        "timeout": {
          "type": "integer",
          "title": "Readiness Timeout (minutes)",
          "default": 1,
          "minimum": 1
        },
        "imagePullSecrets": {
          "type": "array",
          "title": "Image Pull Secrets",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "title": "Secret Name"
              }
            },
            "required": ["name"]
          },
          "default": [{ "name": "regcred" }]
        }
      }
    },
    "mysql": {
      "type": "object",
      "title": "MySQL",
      "properties": {
        "enabled": {
          "type": "boolean",
          "title": "Enabled",
          "default": true
        },
        "oai5gdatabase": {
          "type": "string",
          "title": "Database Name",
          "default": "basic"
        },
        "persistence": {
          "type": "object",
          "title": "Persistence",
          "properties": {
            "enabled": {
              "type": "boolean",
              "title": "Persistence Enabled",
              "default": false
            }
          }
        }
      }
    },
    "oai-nrf": {
      "type": "object",
      "title": "NRF (Network Repository Function)",
      "properties": {
        "enabled": {
          "type": "boolean",
          "title": "Enabled",
          "default": true
        },
        "nfimage": {
          "type": "object",
          "title": "Image",
          "properties": {
            "repository": {
              "type": "string",
              "title": "Repository",
              "default": "docker.io/oaisoftwarealliance/oai-nrf"
            },
            "version": {
              "type": "string",
              "title": "Version",
              "default": "v2.2.0"
            },
            "pullPolicy": {
              "type": "string",
              "title": "Pull Policy",
              "enum": ["IfNotPresent", "Always", "Never"],
              "default": "IfNotPresent"
            }
          }
        },
        "start": {
          "type": "object",
          "title": "Start Flags",
          "properties": {
            "nrf": {
              "type": "boolean",
              "title": "Start NRF",
              "default": true
            }
          }
        }
      }
    },
    "oai-lmf": {
      "type": "object",
