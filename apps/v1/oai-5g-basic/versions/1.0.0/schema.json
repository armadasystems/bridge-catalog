            "enabled": {
              "type": "boolean",
              "title": "Enable Multus",
              "default": false
            },
            "interfaces": {
              "type": "array",
              "title": "Interfaces",
              "items": {
                "type": "object",
                "properties": {
                  "name": { "type": "string", "title": "Interface Name" },
                  "hostInterface": { "type": "string", "title": "Host Interface", "default": "eth0" },
                  "ipAdd": { "type": "string", "title": "IP Address" },
                  "netmask": { "type": "string", "title": "Netmask" },
                  "defaultRoute": { "type": "string", "title": "Default Route" },
                  "gateway": { "type": "string", "title": "Gateway" },
                  "routes": { "type": "string", "title": "Routes" },
                  "enabled": { "type": "boolean", "title": "Enabled", "default": true }
                }
              },
              "default": [
                {
                  "name": "n2",
                  "hostInterface": "eth0",
                  "ipAdd": "172.21.6.90",
                  "netmask": "22",
                  "routes": "",
                  "defaultRoute": "172.21.7.254",
                  "enabled": true
                },
                {
                  "name": "sbi",
                  "hostInterface": "eth0",
                  "ipAdd": "172.21.8.91",
                  "netmask": "22",
                  "gateway": "172.21.11.254",
                  "enabled": true
