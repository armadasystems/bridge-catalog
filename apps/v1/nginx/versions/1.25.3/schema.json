{
    "type": "object",
    "required": ["replicaCount"],
    "properties": {
      "replicaCount": {
        "type": "integer",
        "title": "Replica Count",
        "default": 1,
        "minimum": 1
      },
      "image": {
        "type": "object",
        "title": "Image Settings",
        "properties": {
          "registry": {
            "type": "string",
            "default": "harbor.internal.local"
          },
          "repository": {
            "type": "string",
            "default": "amcop/nginx"
          },
          "tag": {
            "type": "string",
            "default": "1.25.3-debian-11-r4"
          },
          "pullPolicy": {
            "type": "string",
            "default": "IfNotPresent"
          }
        }
      },
      "service": {
        "type": "object",
        "title": "Service Configuration",
        "properties": {
          "type": {
            "type": "string",
            "title": "Service Type",
            "enum": ["ClusterIP", "NodePort", "LoadBalancer"],
            "default": "ClusterIP"
          },
          "port": {
            "type": "integer",
            "title": "Service Port",
            "default": 80
          }
        }
      },
      "ingress": {
        "type": "object",
        "title": "Ingress",
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": false
          },
          "hostname": {
            "type": "string",
            "title": "Hostname",
            "default": "nginx.local"
          }
        }
      }
    }
  }
  