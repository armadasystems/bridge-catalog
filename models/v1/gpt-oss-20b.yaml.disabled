  minRequiredRamInGb: 6
  minRequiredVramInGb: 16
  requiredDiscSizeInGb: 16
dType: ["auto", "bfloat16", "float", "float16", "float32", "half"]
config:
  maxPositionEmbeddings: 131072
metadata:
  securityScan: true
